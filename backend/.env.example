# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:3000
# Public storefront URL used to build order links inside emails
STOREFRONT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/lylaglass

# Auth (admin dashboard)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@lylaglass.vn
ADMIN_SEED_PASSWORD=change-this-password

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# Payments — VietQR bank transfer to the shop's TPBank account
#
# VietQR only GENERATES the transfer QR. Payment is confirmed exclusively by an
# incoming-transfer webhook from the bank notification provider (see below).
# ----------------------------------------------------------------------------
PAYMENT_PROVIDER=vietqr

# NAPAS BIN encoded into the QR. TPBank = 970423 (do not confuse with the short code).
VIETQR_BANK_BIN=970423
# Short bank code, used for display only. TPBank = TPB.
VIETQR_BANK_CODE=TPB
VIETQR_BANK_NAME=TPBank
# Beneficiary account — the shop's TPBank account number. Never hard-code this.
VIETQR_ACCOUNT_NUMBER=
# Account holder name as registered with TPBank (shown to the customer).
VIETQR_ACCOUNT_NAME=

# How long a customer has to complete the transfer, counted from Payment.createdAt.
PAYMENT_TTL_MINUTES=15
# How often the background job expires overdue payments / retries failed emails.
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=60000

# ----------------------------------------------------------------------------
# Bank notification provider (incoming-transfer webhook)
#
# SePay watches the TPBank account and POSTs every balance change to
# POST /api/payments/bank-webhook. Docs: https://docs.sepay.vn
# ----------------------------------------------------------------------------
BANK_WEBHOOK_PROVIDER=sepay
# "hmac" (recommended) or "apikey" — must match what you configured in SePay.
BANK_WEBHOOK_AUTH_MODE=hmac
# HMAC-SHA256 shared secret (BANK_WEBHOOK_AUTH_MODE=hmac). Keep secret.
BANK_WEBHOOK_SECRET=
# API key SePay sends as `Authorization: Apikey <key>` (BANK_WEBHOOK_AUTH_MODE=apikey).
BANK_WEBHOOK_API_KEY=
# Replay window for HMAC-signed requests, in seconds.
BANK_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ----------------------------------------------------------------------------
# Transactional email (payment confirmation)
# "log" writes the email to the server log instead of sending it (local dev).
# "resend" sends through https://resend.com — EMAIL_API_KEY is a Resend API key.
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=LylaGlass <no-reply@lylaglass.vn>
EMAIL_REPLY_TO=
EMAIL_MAX_ATTEMPTS=3

# Shop-side "new paid order" alert. Comma-separated, can be several people.
# Leave empty to disable it — the customer's confirmation email is unaffected.
ORDER_NOTIFICATION_EMAILS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
