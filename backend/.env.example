# Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Public storefront URL — used to build order-lookup links inside customer emails.
STOREFRONT_URL=http://localhost:3000
# Admin app's own URL — a SEPARATE origin from the storefront (see the CORS /
# cookie section below for why). Used to build the "new paid order" link
# inside the shop-owner alert email.
ADMIN_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# CORS — every browser origin allowed to call this API with credentials
#
# Comma-separated. Must list BOTH the storefront and the admin app exactly —
# no wildcards, no trailing slash. An origin not in this list gets no
# Access-Control-Allow-Origin header at all, so the browser blocks the response
# regardless of what the server returned.
#
# Local dev default already covers the storefront (3000) and frontend-admin
# (3001) started via their own `npm run dev`.
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----------------------------------------------------------------------------
# Database — MongoDB Atlas
#
# Checkout and payment settlement run inside multi-document transactions, which
# REQUIRE a replica set. Atlas is always a replica set, including the free M0
# tier, so use an Atlas connection string in production:
#
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lylaglass?retryWrites=true&w=majority
#
# For local development, `docker compose up -d mongo` starts a single-node
# replica set (rs0) so development matches production semantics:
#
#   mongodb://localhost:27017/lylaglass?replicaSet=rs0&directConnection=true
#
# Pointing this at a standalone mongod makes the server refuse to boot in
# production, and fall back to non-atomic compensating logic in development.
# ----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/lylaglass?replicaSet=rs0&directConnection=true
# Atlas M0 allows 500 connections cluster-wide — keep the pool small.
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000
# Refuse to start in production when the deployment cannot run transactions.
MONGODB_REQUIRE_TRANSACTIONS=true

# ----------------------------------------------------------------------------
# Auth (admin dashboard)
#
# The admin session lives in an httpOnly cookie (never in localStorage or a
# response body the admin app's JS could read), and every state-changing admin
# request additionally requires a CSRF token — see utils/csrf.ts for why this
# is a synchronizer token rather than a classic double-submit cookie, which is
# what the split-origin architecture here specifically requires.
# ----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Separate from JWT_SECRET on purpose — see utils/csrf.ts.
CSRF_SECRET=change-this-to-a-different-long-random-string
# Cookie's Domain attribute. Leave EMPTY (recommended): the cookie becomes
# host-only, scoped to exactly this API's own host. That is what keeps a
# storefront XSS from ever seeing it via document.cookie — the browser still
# attaches it correctly to admin-app-initiated requests because attachment is
# based on the request's TARGET host, not which page's script sent it. Only
# set this if the API is deliberately meant to share the cookie beyond the
# admin app (not the default posture, and it weakens the isolation above).
ADMIN_COOKIE_DOMAIN=
ADMIN_SEED_EMAIL=admin@lylaglass.vn
ADMIN_SEED_PASSWORD=change-this-password

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----------------------------------------------------------------------------
# Payments — VietQR bank transfer to the shop's TPBank account
#
# VietQR only GENERATES the transfer QR. Payment is confirmed exclusively by an
# incoming-transfer webhook from the bank notification provider (see below).
# ----------------------------------------------------------------------------
PAYMENT_PROVIDER=vietqr

# NAPAS BIN encoded into the QR. TPBank = 970423 (do not confuse with the short code).
VIETQR_BANK_BIN=970423
# Short bank code, used for display only. TPBank = TPB.
VIETQR_BANK_CODE=TPB
VIETQR_BANK_NAME=TPBank
# Beneficiary account — the shop's TPBank account number. Never hard-code this.
VIETQR_ACCOUNT_NUMBER=
# Account holder name as registered with TPBank (shown to the customer).
VIETQR_ACCOUNT_NAME=

# How long a customer has to complete the transfer, counted from Payment.createdAt.
PAYMENT_TTL_MINUTES=15
# How often the background job expires overdue payments / retries failed emails.
PAYMENT_EXPIRY_SWEEP_INTERVAL_MS=60000

# ----------------------------------------------------------------------------
# Bank notification provider (incoming-transfer webhook)
#
# SePay watches the TPBank account and POSTs every balance change to
# POST /api/payments/bank-webhook. Docs: https://docs.sepay.vn
# ----------------------------------------------------------------------------
BANK_WEBHOOK_PROVIDER=sepay
# "hmac" (recommended) or "apikey" — must match what you configured in SePay.
BANK_WEBHOOK_AUTH_MODE=hmac
# HMAC-SHA256 shared secret (BANK_WEBHOOK_AUTH_MODE=hmac). Keep secret.
BANK_WEBHOOK_SECRET=
# API key SePay sends as `Authorization: Apikey <key>` (BANK_WEBHOOK_AUTH_MODE=apikey).
BANK_WEBHOOK_API_KEY=
# Replay window for HMAC-signed requests, in seconds.
BANK_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ----------------------------------------------------------------------------
# Transactional email — Gmail API (OAuth2 refresh token)
#
# Two emails are sent per successful payment:
#   1. confirmation  -> the buyer's address from checkout
#   2. new-order alert -> ORDER_NOTIFICATION_EMAILS (the shop owner)
#
# "log"   writes the email to the server log instead of sending it (local dev).
# "gmail" sends through the Gmail API as GMAIL_SENDER.
#
# One-time setup to obtain the refresh token:
#   1. Google Cloud Console -> create a project -> enable the "Gmail API".
#   2. OAuth consent screen: External, add GMAIL_SENDER as a test user
#      (a published app is only needed if you send as many mailboxes).
#   3. Credentials -> Create OAuth client ID -> "Desktop app".
#      Note the client ID and client secret.
#   4. Visit (one line, with your client id):
#      https://accounts.google.com/o/oauth2/v2/auth
#        ?client_id=<GMAIL_CLIENT_ID>
#        &redirect_uri=http://localhost
#        &response_type=code
#        &scope=https://www.googleapis.com/auth/gmail.send
#        &access_type=offline&prompt=consent
#      Approve, then copy the `code` query parameter from the redirect URL.
#   5. Exchange it for a refresh token:
#      curl -s https://oauth2.googleapis.com/token \
#        -d client_id=<GMAIL_CLIENT_ID> -d client_secret=<GMAIL_CLIENT_SECRET> \
#        -d code=<CODE> -d grant_type=authorization_code \
#        -d redirect_uri=http://localhost
#      Copy `refresh_token` from the response into GMAIL_REFRESH_TOKEN.
#
# The grant is scoped to gmail.send only — it cannot read the mailbox — and can
# be revoked at any time from the Google account's security settings.
#
# Sending limits: ~500 recipients/day on a free @gmail.com account, ~2000/day on
# Google Workspace. At ~5 orders/day (2 emails each) this is far from binding.
# ----------------------------------------------------------------------------
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The mailbox the refresh token belongs to, e.g. shop@lylaglass.vn
GMAIL_SENDER=
# Must be GMAIL_SENDER or one of its verified "send mail as" aliases in Gmail.
EMAIL_FROM=LylaGlass <no-reply@lylaglass.vn>
EMAIL_REPLY_TO=
EMAIL_MAX_ATTEMPTS=3

# Shop-side "new paid order" alert. Comma-separated, can be several people.
# Leave empty to disable it — the customer's confirmation email is unaffected.
ORDER_NOTIFICATION_EMAILS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
